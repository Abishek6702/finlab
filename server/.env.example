PORT=9003
NODE_ENV=development

# Use a dedicated local/test database. Production credentials belong in a secret manager.
MONGO_URI=mongodb://127.0.0.1:27017/finlab_dev
MONGO_TEST_URI=mongodb://127.0.0.1:27017/finlab_integration_test?replicaSet=rs0

FRONTEND_URL=http://localhost:9001,http://localhost:9002
CLIENT_URL=http://localhost:9002

JWT_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

EMAIL_USER=
EMAIL_PASS=
PASSWORD_RESET_EXPIRES_MINUTES=15
COOKIE_SECURE=false

# Local time in each user's saved timezone for the daily income/spending summary (24-hour HH:mm)
DAILY_SUMMARY_TIME=16:15
DAILY_SUMMARY_URL=/dashboard

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
