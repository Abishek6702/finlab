# FinLab Client Environment Variables
# Local Development: http://localhost:9003/api
# Production Example: https://your-backend-api.onrender.com/api (or https://api.finlab.app/api)
VITE_API_BASE_URL=http://localhost:9003/api

# Optional: Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=

# Optional: Public Landing Page URL (e.g. https://finlab-save.vercel.app)
VITE_LANDING_URL=http://localhost:9001
